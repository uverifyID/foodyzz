{
  "expo": {
    "name": "Foodyzz",
    "slug": "foodyzz",
    "scheme": "com.rajshrestha.foodyzz",
    "version": "3.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/logo/icon/appicon.png",
    "plugins": [
      "./withAndroidPathFix",
      "./withNotificationSounds",
      "./withFmtConstevalFix",
      "./withPodsMinDeploymentTarget",
      "./withUISceneLifecycle",
      "./withFirebaseAuthSwiftOptFix",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Foodyzz to access your photos so you can upload your driver license.",
          "cameraPermission": "Allow Foodyzz to use your camera to photograph your driver license and take your selfie."
        }
      ],
      "expo-font",
      "expo-notifications",
      "@react-native-firebase/app",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          },
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "15.1",
            "extraPods": [
              {
                "name": "RecaptchaEnterprise",
                "version": "~> 18.9.1"
              }
            ]
          }
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo/mainpage/splashscreen.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Foodyzz checks your location once, while you are at your delivery address, to confirm where your bike will be delivered."
        }
      ],
      "expo-web-browser"
    ],
    "newArchEnabled": false,
    "platforms": [
      "ios",
      "android"
    ],
    "android": {
      "package": "com.foodyzz",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo/icon/appicon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.foodyzz",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to access your camera to photograph your driver license for bike rental verification.",
        "NSMicrophoneUsageDescription": "$(PRODUCT_NAME) does not record audio. Microphone access is included by an audio library used only to play notification sounds.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.392804438663-ju539i8hqp7dcepr0mhvbmuamm6ol1mf"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "com.rajshrestha.foodyzz"
            ]
          }
        ]
      },
      "appleTeamId": "59BW5VWV38"
    },
    "owner": "rajshrestha",
    "extra": {
      "eas": {
        "projectId": "1ec4bb03-de37-42be-a411-0901612e5c51"
      }
    }
  }
}
