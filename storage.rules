rules_version = '2';

// Foodyzz Cloud Storage rules.
//
// The only thing in this bucket is customer identity documents, so the default is
// deny and every path is opened deliberately.
//
// IMPORTANT: Storage rules cannot read Firestore. That means we cannot express
// "a provider may read this licence because they have an active order for this
// customer" the way the Firestore rules do. Access is therefore driven purely by
// the auth token: the owning customer (phone claim) and Foodyzz staff.
//
// TWO staff claims, both minted by syncAdminClaim:
//   admin   — the platform staff allowlist (staff/{phone}). Everything.
//   hqStaff — belongs to at least one store (providers/{id}/members/{phone}).
//
// hqStaff exists because a store can now be run by several people, and checking
// a customer's ID at delivery is the job. Granting those members `admin` instead
// would make "invite a colleague" an indirect route to platform admin — apiConfig
// writes, bulkBroadcast to every customer, fleet writes — handed out by any store
// owner to anyone they choose. So hqStaff carries exactly what the delivery job
// needs and nothing else: read identity documents, write handover photos.
//
// It is still platform-wide rather than per-store, for the Storage-rules reason
// above. Narrowing it to "only customers my store is serving" needs signed URLs
// minted by a callable that can actually check the order.
service firebase.storage {
  match /b/{bucket}/o {

    // Foodyzz platform staff: the admin hub and enrolled FoodyzzHQ devices.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Anyone who belongs to a store. Strictly weaker than isAdmin — it appears
    // ONLY on the document-read and handover-photo rules below.
    function isHqStaff() {
      return request.auth != null && request.auth.token.hqStaff == true;
    }

    // The customer the document belongs to. Licence paths are keyed by the E.164
    // phone number, which is exactly what the phone-auth token carries.
    function ownsPhone(phone) {
      return request.auth != null && request.auth.token.phone_number == phone;
    }

    // driverLicenses/{phone}/front.jpg | back.jpg  (see services/driverLicense.ts)
    //
    // Read  — the owner, so they can see what they submitted; and staff, for the
    //         manual review in the admin hub and the ID check at delivery. Store
    //         members (hqStaff) do that check too, so they read as well.
    // Write — the OWNER ONLY. Staff review licences, they never replace one, and a
    //         staff-writable path would let any HQ device forge a customer's ID.
    //         Capped at 10 MB and restricted to images so the path can't be used
    //         as general-purpose storage.
    match /driverLicenses/{phone}/{fileName} {
      allow read: if ownsPhone(phone) || isAdmin() || isHqStaff();
      allow write: if ownsPhone(phone)
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // addressProofs/{phone}/front.jpg — same ownership model as the licence.
    match /addressProofs/{phone}/{fileName} {
      allow read: if ownsPhone(phone) || isAdmin() || isHqStaff();
      allow write: if ownsPhone(phone)
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // bikeCondition/{orderId}/*.jpg — handover photos taken by FoodyzzHQ with the
    // customer present. Staff write them; both sides read them, so any authed user
    // may read (the path is keyed by an unguessable order id).
    match /bikeCondition/{orderId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if (isAdmin() || isHqStaff())
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Everything else is denied. Admin-SDK access (Cloud Functions) bypasses these
    // rules entirely, so server-side cleanup still works.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
