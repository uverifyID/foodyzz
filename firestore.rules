rules_version = '2';

// ============================================================================
// HARDENED RULES — deployed 2026-06-25.
// Previous version allowed ANY authenticated user to write ANY providers/orders/
// promos doc (incl. provider bank details). This version owner-scopes the
// sensitive writes while preserving every real write path:
//   - providers/orders: scoped to the owner (see helpers); admins bypass.
//   - order UPDATE stays broad so providers can advance status (dispatch flow).
//   - messages/supportMessages/promos: unchanged (broad) — see TODOs.
// Admin identity = the `admin:true` custom claim (same check bulkBroadcast uses).
// NOTE: phone on doc ids/fields is digits-only ("14022039987"); the auth claim
// is E.164 ("+14022039987"), matched via '+' concat.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Belongs to at least one store (providers/{id}/members/{phone}), granted by
    // syncAdminClaim. Strictly weaker than isAdmin: it appears ONLY on the customer
    // document-review write below, and on reading identity documents in
    // storage.rules. Deliberately not `admin`, or inviting a colleague to a store
    // would hand them apiConfig writes and bulkBroadcast over the whole platform.
    function isHqStaff() {
      return request.auth != null && request.auth.token.hqStaff == true;
    }

    // Digits-only phone field, prefixed with '+', must equal the E.164 claim.
    function ownsPhoneField(digitsPhone) {
      return request.auth != null
             && ('+' + digitsPhone) == request.auth.token.phone_number;
    }

    // A store can be run by SEVERAL people. The doc id `${phone}_${identifier}`
    // names only whoever created it, so membership — not the id — is the access
    // check: providers/{id}/members/{E164phone} exists. Those docs are written
    // exclusively by Cloud Functions (redeemHqInvite / onProviderCreatedAddOwner);
    // a client-writable member doc would let anyone join any store.
    //
    // Costs one document read per evaluation, so it is always placed AFTER
    // ownsPhoneField in an `||` — rules short-circuit, so the common case (an
    // owner writing their own store) pays nothing.
    function isMember(providerId) {
      return request.auth != null
             && exists(/databases/$(database)/documents/providers/$(providerId)/members/$(request.auth.token.phone_number));
    }

    // Public, NON-sensitive config docs — `global` (commission, fees, publishableKey,
    // Google Maps client key, legal links) AND `logistics` (bike models, rates, fees,
    // delivery windows). Readable pre-auth so the login screen can show the T&C link and
    // the rental flow can price. Stripe SECRETS live in apiConfigSecret/* (denied to all
    // clients below); functions read those via the admin SDK and merge them in.
    match /apiConfig/{docId} {
      allow read: if true;
      // Admin hub (GlobalConfigTab) writes bike rates / fees / delivery windows here.
      // NON-sensitive config only — Stripe secrets live in apiConfigSecret/* (still deny-all).
      allow write: if isAdmin();
    }

    // Server-only secrets (Stripe secretKey / webhook secret). Never readable or
    // writable by any client — only Cloud Functions (admin SDK) can access them.
    match /apiConfigSecret/{doc} {
      allow read, write: if false;
    }

    // Staff allowlist — `staff/{E164phone}` is the ONLY source of the admin claim
    // (see the syncAdminClaim function). Deny-all to clients: a client-writable
    // allowlist would be self-grant, and the admin claim reads every customer's
    // identity documents. Populate via the Firebase Console or the admin SDK.
    match /staff/{phone} {
      allow read, write: if false;
    }

    // Single-use join codes, issued per person by a manager (scripts/invite-member.js)
    // and redeemed by the redeemHqInvite function. Deny-all: the CODE is the
    // credential, so a readable collection would be an enumerable key ring, and a
    // writable one would be self-grant into any store.
    match /invites/{code} {
      allow read, write: if false;
    }

    // Providers - any authed user may read (browse stores); the owning phone, any
    // MEMBER of the store, or an admin may write. Protects bankAccount / Stripe
    // fields from everyone else.
    match /providers/{providerId} {
      allow read: if request.auth != null;
      // CREATE stays owner-only: you make your own store, you don't conjure
      // someone else's. (A member doc cannot exist yet at creation time anyway.)
      allow create: if ownsPhoneField(request.resource.data.phoneNumber) || isAdmin();
      allow update: if ownsPhoneField(request.resource.data.phoneNumber)
                    || isMember(providerId) || isAdmin();
      // DELETE stays owner/admin — joining a store must not let a member destroy it.
      allow delete: if ownsPhoneField(resource.data.phoneNumber) || isAdmin();

      // Who may operate this store. Server-written only (see isMember above).
      // Readable by the store's own members so the team roster can be shown.
      match /members/{memberPhone} {
        allow read: if isMember(providerId) || isAdmin();
        allow write: if false;
      }

      // Redacted public reviews (first name + stars + comment only), written by the
      // onOrderUpdatedUpdateStats function so any authed customer can browse them.
      match /reviews/{reviewId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // Collection-group read over members, used by the app's store switcher to find
    // every store the signed-in phone belongs to in ONE query. Deliberately
    // self-only and phrased as an equality on the same field the query filters on:
    // that is what makes the query provably safe to the rules engine, and it means
    // this rule can never widen the per-store roster read above.
    match /{path=**}/members/{memberPhone} {
      allow read: if request.auth != null
                  && resource.data.phone == request.auth.token.phone_number;
    }

    // Users (customers) - self-only profile writes; admin may write (block flag).
    //
    // Split out of a single `write` so the document-review carve-out below can use
    // diff(), which needs an existing resource.data and so is meaningless on create.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if (request.auth != null && request.auth.token.phone_number == userId)
                    || isAdmin();
      allow delete: if (request.auth != null && request.auth.token.phone_number == userId)
                    || isAdmin();

      // Approving or rejecting a customer's ID is the delivery job, so store staff
      // must be able to stamp the review — but ONLY that. hasOnly() pins them to
      // the two document maps, so a store member cannot flip isBlocked, rewrite an
      // address, or touch a Stripe customer id on the same write. Anything wider
      // stays admin-only.
      //
      // Platform-wide rather than per-store: scoping to "a customer my store is
      // serving" would mean querying orders, and rules can only get() a known path.
      allow update: if (request.auth != null && request.auth.token.phone_number == userId)
                    || isAdmin()
                    || (isHqStaff()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['driverLicense', 'addressProof']));
    }

    // Orders - carry the customer's charge & authorization amounts, so READ is
    // restricted to the owning customer or an admin. Providers must NEVER see these
    // amounts; they read the redacted `providerOrders` mirror instead (below).
    // CREATE must be by the customer themselves (or admin).
    //
    // UPDATE is allow-listed BY FIELD, per role. It used to be a bare
    // `request.auth != null`, which reads as "staff only" but is not: the customer
    // app signs every rider in with phone auth, so it granted write on every order
    // to the whole customer base. Two paths made that a live money bug — capture
    // takes min(order.finalPrice || order.estimatedPrice, authorized) and delivery
    // reads order.depositAmount, both from the order doc, so a customer could
    // rewrite their own order before delivery and be charged a cent with no deposit.
    //
    // Everything that decides what is charged (prices, deposit, Stripe ids, bike
    // assignment, coupons, billing schedule) is therefore writable only by the Admin
    // SDK — Cloud Functions bypass these rules, and every such mutation already goes
    // through a callable (cancelOrder, capturePaymentIntent, assignBikeToOrder,
    // markRentalDelivered, chargeDeposit, payoffRentToBuy, setOrderNote, ...).
    // Adding a field to a list below puts it back in reach of a client: only add
    // fields that are pure workflow state and cannot influence an amount.
    function orderCustomerFields() {
      // The customer app touches exactly one field directly (clearing its own chat
      // badge, foodyzz ChatScreen). Everything else it does is a callable.
      return ['customerUnreadMessage'];
    }
    function orderHqFields() {
      // The HQ app's direct writes: status advance (Dispatch/Logistics), provider
      // identity stamped on accept, the return-run stage, the document review gate,
      // and its own chat badge.
      return [
        'status', 'updatedAt',
        'providerId', 'providerName', 'providerPhone',
        'readyForDeliveryAt', 'completedAt',
        'returnStage', 'returnStageAt',
        'idRequestedAt', 'idRequestedBy', 'docsVerifiedAt', 'docsRejectedAt',
        'providerUnreadMessage',
      ];
    }
    function orderChangedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    match /orders/{orderId} {
      allow read: if request.auth != null
                  && (resource.data.customerPhone == request.auth.token.phone_number || isAdmin());
      allow create: if (request.auth != null
                        && request.resource.data.customerPhone == request.auth.token.phone_number)
                    || isAdmin();
      // isAdmin (staff/{phone} allowlist) is unrestricted — platform operators.
      // isHqStaff (member of any store) may drive the order workflow but not its money.
      // The owning customer may clear their own unread badge and nothing else.
      allow update: if isAdmin()
                    || (isHqStaff() && orderChangedKeys().hasOnly(orderHqFields()))
                    || (request.auth != null
                        && resource.data.customerPhone == request.auth.token.phone_number
                        && orderChangedKeys().hasOnly(orderCustomerFields()));
    }

    // Provider-safe order mirror — written only by onOrderWriteMirrorForProvider.
    //
    // "Provider-safe" means safe for STAFF, not for everyone: the mirror copies every
    // order field except four raw Stripe identifiers, so it still carries the
    // customer's name, phone, email, home address and GPS coordinates. Read was
    // `request.auth != null`, and the customer app phone-auths every rider — so any
    // customer could list this collection and walk off with the platform's entire
    // customer base, addresses included.
    //
    // Only the HQ app reads it (dispatch feed, chat threads, logistics, QR scan);
    // the customer app and the web console never touch it. Scoped to staff.
    match /providerOrders/{orderId} {
      allow read: if isAdmin() || isHqStaff();
      allow write: if false;
    }

    // Promos — marketing offers, created and retired by store staff in the HQ app.
    //
    // Write was open to any authed user, and resolveCoupon (functions) prices a
    // checkout straight off this collection: it looks up by `offerCode`, then reads
    // `isActive`, `offerType`, `discountType` and `discountValue` from the doc it
    // finds. A customer could therefore write themselves a 100%-off promo and have
    // the server honour it — the only backstop was the cap at subtotal, which keeps
    // it from becoming credit but still zeroes the rental.
    //
    // Read stays open: the customer app's offers carousel and code lookup both need
    // it, and single use is enforced server-side against promoRedemptions.
    match /promos/{promoId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isHqStaff();
    }

    // Promo redemptions - the single-use ledger. One doc per (promo, customer), written
    // only by createPaymentIntent / onOrderCreatedRedeemPromo. Closed to clients in BOTH
    // directions on purpose: a customer who could delete their own claim doc could spend
    // the same code twice, and one who could read the collection could enumerate who
    // redeemed what. The Admin SDK bypasses these rules.
    match /promoRedemptions/{claimId} {
      allow read, write: if false;
    }

    // Support messages - unchanged (broad: customers, providers, admin all post).
    match /supportMessages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Order chat messages - unchanged.
    match /messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }

    // Archived users - self-only (account-deletion flow).
    match /archivedUsers/{userId} {
      allow create: if request.auth != null
                    && request.auth.token.phone_number == userId;
    }

    // Archived providers - self-only (provider account-deletion / "Purge HQ Record"
    // flow). The doc id is `${phone}_${zip}`, so unlike archivedUsers we can't key on
    // the id; scope by the owning phone FIELD on the archived copy instead, exactly
    // like the providers rule. Without this the set() hit the default-deny below and
    // surfaced as "Archival sequence failed."
    match /archivedProviders/{archivedId} {
      allow create: if ownsPhoneField(request.resource.data.phoneNumber) || isAdmin();
    }

    // Physical bike inventory. Any authed client reads it — the customer app needs
    // live availability per model to quote a rental, and FoodyzzHQ needs it to pick
    // the bike it hands over. Writes are admin (fleet management from the admin hub)
    // or server-side, so a customer can never mark a bike available/rented.
    match /bikes/{bikeId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();

      // Append-only rental history per bike. Admin-only: it names the renter.
      match /history/{entryId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // Aggregated daily stats and per-provider performance rollups, written by
    // Cloud Functions. Only the admin hub reads them.
    match /stats/{date} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /providerPerformance/{providerId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Settlement ledger — one document per money movement through Stripe, carrying
    // what we charged AND what Stripe kept. That spread is the platform's margin, so
    // it is admin-read only (never the customer, never a store) and server-written.
    match /settlements/{stripeId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
