{
  "name": "foodyzz-provider",
  "version": "1.0.0",
  "main": "./app/index.tsx",
  "scripts": {
    "start": "cross-env NODE_OPTIONS=--max-old-space-size=8192 expo start",
    "android": "cross-env NODE_OPTIONS=--max-old-space-size=8192 expo run:android",
    "ios": "cross-env NODE_OPTIONS=--max-old-space-size=8192 expo run:ios",
    "web": "cross-env NODE_OPTIONS=--max-old-space-size=8192 expo start --web",
    "prebuild": "expo prebuild && npx pod-install",
    "prebuild:clean": "expo prebuild --clean && npx pod-install",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "0.2.3",
    "@expo-google-fonts/jetbrains-mono": "0.2.3",
    "@expo-google-fonts/space-grotesk": "0.2.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^22.4.0",
    "@react-native-firebase/auth": "^22.4.0",
    "@react-native-firebase/firestore": "^22.4.0",
    "@react-native-firebase/functions": "^22.4.0",
    "@react-native-firebase/storage": "^22.4.0",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "@stripe/stripe-react-native": "0.50.3",
    "expo": "^54.0.36",
    "expo-asset": "~12.0.13",
    "expo-av": "~16.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "1.17.0",
    "nativewind": "2.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "cross-env": "^7.0.3",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "tailwindcss": "3.3.2",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "//": "expo-av is deprecated and is removed in SDK 55; it still ships in SDK 54 and is used only for notification-sound playback. The expo-audio migration is a prerequisite for the SDK 55 bump, not for the Android 16 / API 36 target — silence the advisory until then.",
        "exclude": [
          "expo-av"
        ]
      }
    }
  }
}
