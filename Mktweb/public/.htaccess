# ===================================================================
# UniHamper Marketing (Mktweb) — https://mkt.unihamper.com
# Next.js static export (output: "export", trailingSlash: true) -> out/
# Copied into out/ at build time (see the postbuild copy in package.json).
# ===================================================================

Options -Indexes
AddDefaultCharset UTF-8
DirectoryIndex index.html

# ===================================================================
# Canonical host + HTTPS
# ===================================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # http -> https ; www -> non-www
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://mkt.unihamper.com%{REQUEST_URI} [L,R=301]
</IfModule>

# trailingSlash:true emits /faq/index.html etc.; mod_dir + DirectoryIndex serve
# them and add the trailing slash automatically, so no extra rewrites are needed.

# ===================================================================
# Custom error page (Next emits /404.html at the export root)
# ===================================================================
ErrorDocument 404 /404.html

# ===================================================================
# Compression
# ===================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

# ===================================================================
# Caching — Next fingerprints assets under /_next/static, so they're immutable
# ===================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html               "access plus 0 seconds"
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|jpe?g|webp|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Security headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), camera=(), microphone=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header unset X-Powered-By
</IfModule>

# ===================================================================
# Block hidden / sensitive files
# ===================================================================
<FilesMatch "^\.(?!well-known)">
  Require all denied
</FilesMatch>
