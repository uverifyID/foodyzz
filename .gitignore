# ── Dependencies ─────────────────────────────────────────────
node_modules/

# ── Build output ─────────────────────────────────────────────
build/
dist/
out/
.next/
web-build/
/functions/lib/
*.tsbuildinfo

# ── Expo / React Native ──────────────────────────────────────
.expo/
.expo-shared/

# ── Native build artifacts (iOS / Android) ───────────────────
**/ios/Pods/
**/ios/build/
**/ios/DerivedData/
**/*.xcworkspace/xcuserdata/
**/*.xcodeproj/xcuserdata/
**/android/build/
**/android/.gradle/
# Gradle's cache lives outside android/ too (gemini/), and its .bin/.lock files
# rewrite on every build — a permanently dirty tree that blocks `expo prebuild`.
**/.gradle/
**/android/app/build/
**/android/.cxx/
*.keystore
*.jks

# ── Secrets & credentials — DO NOT COMMIT ────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.mobileprovision
*serviceAccount*.json
*service-account*.json
*firebase-adminsdk*.json
# NOTE: google-services.json / GoogleService-Info.plist are intentionally NOT
# ignored — they are committed so EAS Build can find them. EAS validates the
# googleServicesFile with `git check-ignore --no-index` (pattern-only), so an
# ignore pattern here makes EAS reject the file even when it's git-tracked.
# These are client Firebase configs (keys ship in the app binary); the real
# secret is the *firebase-adminsdk*.json key above, which stays ignored.

# ── Logs (includes logs/git PAT file + runtime logs) ─────────
logs/
*.log
firebase-debug*.log
firestore-debug.log
ui-debug.log
.firebase/

# ── OS / editor cruft ────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
