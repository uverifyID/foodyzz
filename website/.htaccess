# ===================================================================
# Foodyzz — marketing site (foodyzz.com)
# Static HTML — deployed to Hostinger document root for foodyzz.com
# ===================================================================

Options -Indexes
AddDefaultCharset UTF-8
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # http -> https ; www -> apex (canonical host = foodyzz.com)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://foodyzz.com%{REQUEST_URI} [L,R=301]

  # ---- Canonical URL form is the extensionless one: /contact, not /contact.html
  # These three redirects run off THE_REQUEST (the literal browser request line),
  # which the internal rewrite at the bottom never rewrites — so /contact -> contact.html
  # is invisible here and the rules can't ping-pong.

  # /index.html -> /
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  # /privacy.html -> /privacy
  RewriteCond %{THE_REQUEST} \s/+([a-z-]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # /privacy/ -> /privacy  (no trailing slash on clean URLs)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([a-z-]+)/$ /$1 [R=301,L]

  # ---- Serve the real file for the clean URL (internal, no redirect)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([a-z-]+)$ /$1.html [L]
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# Caching: HTML always fresh; assets long-lived
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|jpe?g|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Security headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header unset X-Powered-By
</IfModule>

# Block hidden files
<FilesMatch "^\.(?!well-known)">
  Require all denied
</FilesMatch>
